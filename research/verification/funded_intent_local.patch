@@ -0,0 +1,19 @@
+"""Separate required economic reductions from executable lot-rounding padding."""
+from pathlib import Path
+import numpy as np
+from techquant.data import file_hash
+from research.funded_risk import Owner as FundedOwner, Parameters, grid
+
+
+class Owner(FundedOwner):
+    def identity(self):
+        return {'name': 'funded_economic_intent',
+                'implementation_sha256': file_hash(Path(__file__)),
+                'contract_sha256': file_hash(Path(__file__).with_name('funded_intent_contract.json')),
+                'parent_policy': super().identity(), 'status': 'RESEARCH_NOT_ACCEPTED'}
+
+    def _latch_reductions(self, current, economic, executable):
+        # Padding makes the request executable; it is not a fresh risk obligation.
+        # Only actual units at/below the required ceiling satisfy protection.
+        cuts = economic < current-1e-10
+        self.reduction_ceiling[cuts] = np.minimum(self.reduction_ceiling[cuts], economic[cuts])
 diff --git a/research/test_funded_intent.py b/research/test_funded_intent.py
